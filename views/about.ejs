<%- include('partials/header') %>

<main class="about-page">
    <section class="hero">
        <div class="hero-content">
            <h1>About JIM</h1>
            <p>Your Trusted Partner in Gym Management</p>
        </div>
    </section>

    <section class="about-content">
        <div class="about-grid">
            <div class="about-section">
                <h2>Our Mission</h2>
                <p>To provide a comprehensive and user-friendly gym management solution that helps gym owners and trainers focus on what matters most - helping their members achieve their fitness goals.</p>
            </div>
            
            <div class="about-section">
                <h2>What We Offer</h2>
                <ul>
                    <li>Complete member management system</li>
                    <li>Workout tracking and progress monitoring</li>
                    <li>Performance record keeping</li>
                    <li>Easy-to-use interface for staff and members</li>
                    <li>Real-time analytics and reporting</li>
                </ul>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <h3>Active Users</h3>
                <p>1000+</p>
            </div>
            <div class="stat-card">
                <h3>Workouts Tracked</h3>
                <p>50,000+</p>
            </div>
            <div class="stat-card">
                <h3>Client Satisfaction</h3>
                <p>98%</p>
            </div>
        </div>
    </section>

    <section class="cta">
        <h2>Ready to Get Started?</h2>
        <p>Join the growing community of gyms using our management system.</p>
        <div class="cta-actions">
            <a href="/contact" class="btn btn-primary">Contact Us</a>
            <a href="/members" class="btn btn-secondary">View Demo</a>
        </div>
    </section>
</main>

<link rel="stylesheet" href="/css/about.css">
<link rel="stylesheet" href="/css/responsive.css">

<%- include('partials/footer') %>
