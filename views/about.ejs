<%- include('partials/header') %>

<main class="about-page bg-gray-100">

  <!-- Hero Section -->
  <section class="hero bg-blue-600 text-white py-16">
    <div class="container mx-auto text-center">
      <h1 class="text-4xl font-extrabold">About JIM</h1>
      <p class="mt-4 text-xl">Your Trusted Partner in Gym Management</p>
    </div>
  </section>

  <!-- About Content -->
  <section class="about-content py-16">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8">
        <div class="about-section">
          <h2 class="text-2xl font-bold text-gray-800">Our Mission</h2>
          <p class="mt-4 text-gray-700">To provide a comprehensive and user-friendly gym management solution that helps gym owners and trainers focus on what matters most - helping their members achieve their fitness goals.</p>
        </div>

        <div class="about-section">
          <h2 class="text-2xl font-bold text-gray-800">What We Offer</h2>
          <ul class="mt-4 list-disc pl-6 space-y-2 text-gray-700">
            <li>Complete member management system</li>
            <li>Workout tracking and progress monitoring</li>
            <li>Performance record keeping</li>
            <li>Easy-to-use interface for staff and members</li>
            <li>Real-time analytics and reporting</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Grid -->
  <section class="stats-grid bg-white py-16">
    <div class="container mx-auto px-4">
      <div class="grid sm:grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div class="stat-card p-6 bg-gray-100 rounded-lg shadow-lg">
          <h3 class="text-xl font-semibold text-gray-800">Active Users</h3>
          <p class="mt-2 text-3xl font-bold text-blue-600">1000+</p>
        </div>
        <div class="stat-card p-6 bg-gray-100 rounded-lg shadow-lg">
          <h3 class="text-xl font-semibold text-gray-800">Workouts Tracked</h3>
          <p class="mt-2 text-3xl font-bold text-blue-600">50,000+</p>
        </div>
        <div class="stat-card p-6 bg-gray-100 rounded-lg shadow-lg">
          <h3 class="text-xl font-semibold text-gray-800">Client Satisfaction</h3>
          <p class="mt-2 text-3xl font-bold text-blue-600">98%</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action (CTA) -->
  <section class="cta bg-blue-600 text-white py-16">
    <div class="container mx-auto text-center">
      <h2 class="text-3xl font-extrabold">Ready to Get Started?</h2>
      <p class="mt-4 text-xl">Join the growing community of gyms using our management system.</p>
      <div class="cta-actions mt-8 space-x-4">
        <a href="/contact" class="btn btn-primary px-6 py-3 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition duration-300">Contact Us</a>
        <a href="/members" class="btn btn-secondary px-6 py-3 bg-gray-700 text-white font-semibold rounded-lg hover:bg-gray-800 transition duration-300">View Demo</a>
      </div>
    </div>
  </section>

</main>

