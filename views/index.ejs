<%- include('partials/header') %>

<main class="home-page">
    <div id="error-message" class="error-message" style="display: none;"></div>
    
    <section class="hero">
        <div class="hero-content">
            <h1>Welcome to Gym Manager</h1>
            <p>Your all-in-one solution for managing gym members, workouts, and training records.</p>
            <div class="hero-actions">
                <a href="/members" class="btn-primary">Manage Members</a>
                <a href="/workouts" class="btn-secondary">View Workouts</a>
            </div>
        </div>
    </section>

    <section class="features">
        <h2>Features</h2>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">👥</div>
                <h3>Member Management</h3>
                <p>Easily add, update, and track gym members. Manage memberships and personal information.</p>
                <a href="/members" class="feature-link">Manage Members →</a>
            </div>
            <div class="feature-card">
                <div class="feature-icon">💪</div>
                <h3>Workout Library</h3>
                <p>Create and organize workouts by difficulty and type. Perfect for trainers and members.</p>
                <a href="/workouts" class="feature-link">View Workouts →</a>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📊</div>
                <h3>Training Records</h3>
                <p>Keep track of member progress with detailed workout records and performance metrics.</p>
                <a href="/records" class="feature-link">View Records →</a>
            </div>
        </div>
    </section>

    <section class="quick-stats">
        <h2>Quick Stats</h2>
        <div class="stats-grid">
            <div class="stat-card">
                <h3>Active Members</h3>
                <p id="member-count">Loading...</p>
            </div>
            <div class="stat-card">
                <h3>Available Workouts</h3>
                <p id="workout-count">Loading...</p>
            </div>
            <div class="stat-card">
                <h3>Total Records</h3>
                <p id="record-count">Loading...</p>
            </div>
        </div>
    </section>

    <section class="cta">
        <div class="cta-content">
            <h2>Ready to Get Started?</h2>
            <p>Start managing your gym more efficiently today.</p>
            <a href="/members/new" class="btn-primary">Add New Member</a>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
<script src="/js/home.js"></script>