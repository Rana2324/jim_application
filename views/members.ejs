<%- include('partials/header') %>

<main class="p-6">
  <h1 class="text-3xl font-semibold mb-6">Member Management</h1>

  <!-- Add New Member Form -->
  <section class="form-section mb-10">
    <h2 class="text-2xl font-medium mb-4">Add New Member</h2>
    <form id="member-form" method="POST" action="/api/v1/members" class="space-y-6">
      <div class="form-group">
        <label for="name" class="block text-sm font-medium text-gray-700">Full Name:</label>
        <input type="text" id="name" name="name" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" pattern="[A-Za-z\s]+" title="Name should only contain letters and spaces">
        </div>

      <div class="form-group">
        <label for="email" class="block text-sm font-medium text-gray-700">Email:</label>
        <input type="email" id="email" name="email" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>

      <div class="form-group">
        <label for="phone" class="block text-sm font-medium text-gray-700">Phone:</label>
        <div class="phone-input-group flex space-x-2">
          <select id="country-code" class="country-code-select w-1/4 p-2 border border-gray-300 rounded-md">
            <option value="+1">🇺🇸 +1 (USA/Canada)</option>
            <option value="+81">🇯🇵 +81 (Japan)</option>
            <option value="+880">🇧🇩 +880 (Bangladesh)</option>
            <option value="+91">🇮🇳 +91 (India)</option>
            </select>
          <input type="tel" id="phone" name="phone" required class="mt-1 block w-3/4 px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" pattern="\+\d{1,3}\s\(\d{1,4}\)\s\d{3,4}[-\s]\d{4}" placeholder="(XXX) XXX-XXXX" title="Please enter a valid phone number with country code">
          </div>
        </div>

      <div class="form-group">
        <label for="membershipType" class="block text-sm font-medium text-gray-700">Membership Type:</label>
        <select id="membershipType" name="membershipType" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="basic">Basic</option>
            <option value="premium">Premium</option>
            <option value="platinum">Platinum</option>
          </select>
        </div>

      <div class="form-group">
        <label for="password" class="block text-sm font-medium text-gray-700">Password:</label>
        <input type="password" id="password" name="password" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" minlength="4">
      </div>

      <div class="form-group">
        <label for="gender" class="block text-sm font-medium text-gray-700">Gender:</label>
        <select id="gender" name="gender" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="male">Male</option>
            <option value="female">Female</option>
        </select>
      </div>

      <button type="submit" class="btn-primary px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">Add Member</button>
    </form>
  </section>

  <!-- Members List Section -->
  <section class="members-section">
    <h2 class="text-2xl font-medium mb-4">Members List</h2>
    <div class="cards-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% if (members && members.length > 0) { %>
        <% members.forEach(member => { %>
          <div class="member-card bg-white border border-gray-200 p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold mt-2"><%= member.name %></h3>
            <p class="text-sm text-gray-600"><i class="fas fa-envelope"></i> <%= member.email %></p>
            <p class="text-sm text-gray-600"><i class="fas fa-phone"></i> <%= member.phone %></p>
            <p class="text-sm text-gray-600"><i class="fas fa-star"></i> <%= member.membershipType %></p>
            <p class="text-sm text-gray-600"><i class="fas fa-calendar"></i> Joined: <%= new Date(member.createdAt).toLocaleDateString() %></p>
            <div class="card-actions mt-4 space-x-2">
              <a href="/members/<%= member._id %>" class="btn-view px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 inline-block">View</a>
              <button class="btn-edit px-4 py-2 bg-yellow-400 text-white rounded-md hover:bg-yellow-500" data-id="<%= member._id %>">Edit</button>
              <button class="btn-delete px-4 py-2 bg-red-700 text-white rounded-md hover:bg-red-800" data-id="<%= member._id %>">Delete</button>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <!-- No members message -->
        <div class="no-members text-center text-gray-500 col-span-full">
          <p>No members found. Add your first member using the form above!</p>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Edit Member Modal -->
  <div id="edit-modal" class="modal fixed inset-0 bg-gray-800 bg-opacity-50 flex justify-center items-center hidden">
    <div class="modal-content bg-white p-8 rounded-lg shadow-xl w-full max-w-lg">
      <span class="close absolute top-2 right-2 text-xl font-bold text-gray-500 cursor-pointer">&times;</span>
      <h2 class="text-2xl font-semibold mb-4">Edit Member</h2>
      <form id="edit-form" class="space-y-6">
        <input type="hidden" id="edit-id" name="id">

        <div class="form-group">
          <label for="edit-name" class="block text-sm font-medium text-gray-700">Full Name:</label>
          <input type="text" id="edit-name" name="name" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>

        <div class="form-group">
          <label for="edit-email" class="block text-sm font-medium text-gray-700">Email:</label>
          <input type="email" id="edit-email" name="email" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>

        <div class="form-group">
          <label for="edit-phone" class="block text-sm font-medium text-gray-700">Phone:</label>
          <div class="phone-input-group flex space-x-2">
            <select id="edit-country-code" class="country-code-select w-1/4 p-2 border border-gray-300 rounded-md">
              <option value="+1">🇺🇸 +1 (USA/Canada)</option>
              <option value="+81">🇯🇵 +81 (Japan)</option>
              <option value="+880">🇧🇩 +880 (Bangladesh)</option>
              <option value="+91">🇮🇳 +91 (India)</option>
            </select>
            <input type="tel" id="edit-phone" name="phone" required class="mt-1 block w-3/4 px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" pattern="\+\d{1,3}\s\(\d{1,4}\)\s\d{3,4}[-\s]\d{4}" placeholder="(XXX) XXX-XXXX">
          </div>
          <small class="phone-format-hint text-xs text-gray-500 mt-2">
            Examples:<br>
            🇺🇸 USA/Canada: +1 (123) 456-7890<br>
            🇯🇵 Japan: +81 (90) 1234-5678<br>
            🇧🇩 Bangladesh: +880 (1711) 123-4567<br>
            🇮🇳 India: +91 (999) 123-4567
          </small>
        </div>

        <div class="form-group">
          <label for="edit-membershipType" class="block text-sm font-medium text-gray-700">Membership Type:</label>
          <select id="edit-membershipType" name="membershipType" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="basic">Basic</option>
            <option value="premium">Premium</option>
            <option value="platinum">Platinum</option>
          </select>
        </div>

        <div class="form-group">
          <label for="edit-gender" class="block text-sm font-medium text-gray-700">Gender:</label>
          <select id="edit-gender" name="gender" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="male">Male</option>
            <option value="female">Female</option>
          </select>
        </div>

        <button type="submit" class="btn-primary px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">Update Member</button>
      </form>
    </div>
  </div>

<script src="/js/members.js"></script>
<%- include('partials/footer') %>