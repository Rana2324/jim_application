<%- include('partials/header') %>

<main class="max-w-7xl mx-auto p-4">
  <h1 class="text-4xl font-bold text-center mb-6">Workout Management</h1>
  <div id="error-message" class="message text-red-600 mb-4"></div>

  <!-- Add New Workout Form -->
  <section class="form-section mb-8">
    <h2 class="text-2xl font-semibold mb-4">Add New Workout</h2>
    <form id="workout-form" method="POST" action="/api/v1/workouts" class="space-y-4">
      <div class="form-group">
        <label for="member" class="block text-lg font-medium">Member:</label>
        <select id="member" name="member" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
          <option value="">Select a Member</option>
          <% if (members && members.length > 0) { %>
            <% members.forEach(member => { %>
              <option value="<%= member._id %>"><%= member.name %></option>
            <% }); %>
          <% } %>
        </select>
      </div>
      <div class="form-group">
        <label for="workoutType" class="block text-lg font-medium">Workout Type:</label>
        <select id="workoutType" name="workoutType" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
          <option value="">Select Workout Type</option>
          <option value="strength">Strength Training</option>
          <option value="cardio">Cardio</option>
          <option value="flexibility">Flexibility</option>
          <option value="hiit">HIIT</option>
          <option value="yoga">Yoga</option>
        </select>
      </div>
      <div class="form-group">
        <label for="duration" class="block text-lg font-medium">Duration (minutes):</label>
        <input type="number" id="duration" name="duration" min="1" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600" />
      </div>
      <div class="form-group">
        <label for="date" class="block text-lg font-medium">Date:</label>
        <input type="date" id="date" name="date" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600" />
      </div>
      <div class="form-group">
        <label for="caloriesBurned" class="block text-lg font-medium">Calories Burned:</label>
        <input type="number" id="caloriesBurned" name="caloriesBurned" min="0" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600" />
      </div>
      <button type="submit" class="w-full py-2 px-4 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 transition duration-200">Add Workout</button>
    </form>
  </section>

  <!-- Workouts List -->
  <section class="list-section mb-8">
    <h2 class="text-2xl font-semibold mb-4">Workouts List</h2>
    <div class="filters mb-6">
      <div class="flex space-x-4">
        <select id="member-filter" class="px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
          <option value="">All Members</option>
          <% if (members && members.length > 0) { %>
            <% members.forEach(member => { %>
              <option value="<%= member._id %>"><%= member.name %></option>
            <% }); %>
          <% } %>
        </select>
        <select id="type-filter" class="px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
          <option value="">All Types</option>
          <option value="strength">Strength Training</option>
          <option value="cardio">Cardio</option>
          <option value="flexibility">Flexibility</option>
          <option value="hiit">HIIT</option>
          <option value="yoga">Yoga</option>
        </select>
      </div>
    </div>
    <div id="workouts-list" class="cards-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% if (workouts && workouts.length > 0) { %>
        <% workouts.forEach(workout => { %>
          <div class="workout-card bg-white p-6 rounded-lg shadow-md" 
               data-member="<%= workout.member._id %>" 
               data-type="<%= workout.workoutType %>">
            <h3 class="text-xl font-semibold mb-2">Workout on <%= new Date(workout.date).toLocaleDateString() %></h3>
            <p class="text-gray-600 mb-2"><strong>Member:</strong> <%= workout.member.name %></p>
            <p class="text-gray-600 mb-2"><strong>Type:</strong> <%= workout.workoutType %></p>
            <p class="text-gray-600 mb-2"><strong>Duration:</strong> <%= workout.duration %> minutes</p>
            <p class="text-gray-600 mb-2"><strong>Calories Burned:</strong> <%= workout.caloriesBurned %></p>
            <div class="mt-4 flex space-x-2">
              <a href="/workouts/<%= workout._id %>" class="px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600 transition">View</a>
              <button class="btn-edit px-3 py-1 bg-yellow-500 text-white rounded hover:bg-yellow-600 transition" data-id="<%= workout._id %>">Edit</button>
              <button class="btn-delete px-3 py-1 bg-red-500 text-white rounded hover:bg-red-600 transition" data-id="<%= workout._id %>">Delete</button>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-span-full text-center py-8 text-gray-500">
          <p>No workouts found. Add your first workout using the form above!</p>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Edit Workout Modal -->
  <div id="edit-modal" class="modal fixed inset-0 bg-gray-600 bg-opacity-50 flex justify-center items-center z-50 hidden">
    <div class="modal-content bg-white p-6 rounded-lg w-full max-w-md">
      <span class="close absolute top-2 right-2 text-gray-600 cursor-pointer text-xl">&times;</span>
      <h2 class="text-2xl font-semibold mb-4">Edit Workout</h2>
      <form id="edit-form" class="space-y-4">
        <input type="hidden" id="edit-id">

        <div class="form-group">
          <label for="edit-member" class="block text-lg font-medium">Member:</label>
          <select id="edit-member" name="member" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
            <% if (members && members.length > 0) { %>
              <% members.forEach(member => { %>
                <option value="<%= member._id %>"><%= member.name %></option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <div class="form-group">
          <label for="edit-workoutType" class="block text-lg font-medium">Workout Type:</label>
          <select id="edit-workoutType" name="workoutType" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
            <option value="strength">Strength Training</option>
            <option value="cardio">Cardio</option>
            <option value="flexibility">Flexibility</option>
            <option value="hiit">HIIT</option>
            <option value="yoga">Yoga</option>
          </select>
        </div>

        <div class="form-group">
          <label for="edit-duration" class="block text-lg font-medium">Duration (minutes):</label>
          <input type="number" id="edit-duration" name="duration" min="1" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600" />
        </div>

        <div class="form-group">
          <label for="edit-date" class="block text-lg font-medium">Date:</label>
          <input type="date" id="edit-date" name="date" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600" />
        </div>

        <div class="form-group">
          <label for="edit-caloriesBurned" class="block text-lg font-medium">Calories Burned:</label>
          <input type="number" id="edit-caloriesBurned" name="caloriesBurned" min="0" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600" />
        </div>

        <button type="submit" class="w-full py-2 px-4 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 transition duration-200">Update Workout</button>
      </form>
    </div>
  </div>
</main>

<script src="/js/workouts.js"></script>
<%- include('partials/footer') %>