<%- include('partials/header') %>

<main class="max-w-7xl mx-auto p-4">
  <h1 class="text-4xl font-bold text-center mb-6">Workout Management</h1>
  <div id="error-message" class="message text-red-600 mb-4"></div>

  <!-- Add New Workout Form -->
  <section class="form-section mb-8">
    <h2 class="text-2xl font-semibold mb-4">Add New Workout</h2>
    <form id="workout-form" class="space-y-4">
      <div class="form-group">
        <label for="name" class="block text-lg font-medium">Workout Name:</label>
        <input type="text" id="name" name="name" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600" />
      </div>
      <div class="form-group">
        <label for="description" class="block text-lg font-medium">Description:</label>
        <textarea id="description" name="description" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600"></textarea>
      </div>
      <div class="form-group">
        <label for="duration" class="block text-lg font-medium">Duration (minutes):</label>
        <input type="number" id="duration" name="duration" required min="1" class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600" />
      </div>
      <div class="form-group">
        <label for="difficulty" class="block text-lg font-medium">Difficulty Level:</label>
        <select id="difficulty" name="difficulty" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
          <option value="beginner">Beginner</option>
          <option value="intermediate">Intermediate</option>
          <option value="advanced">Advanced</option>
        </select>
      </div>
      <div class="form-group">
        <label for="category" class="block text-lg font-medium">Category:</label>
        <select id="category" name="category" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
          <option value="strength">Strength Training</option>
          <option value="cardio">Cardio</option>
          <option value="flexibility">Flexibility</option>
          <option value="hiit">HIIT</option>
          <option value="yoga">Yoga</option>
        </select>
      </div>
      <button type="submit" class="w-full py-2 px-4 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 transition duration-200">Add Workout</button>
    </form>
  </section>

  <!-- Workouts List -->
  <section class="list-section mb-8">
    <h2 class="text-2xl font-semibold mb-4">Workouts List</h2>
    <div class="filters mb-6">
      <div class="flex space-x-4">
        <select id="difficulty-filter" class="px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
          <option value="">All Difficulties</option>
          <option value="beginner">Beginner</option>
          <option value="intermediate">Intermediate</option>
          <option value="advanced">Advanced</option>
        </select>
        <select id="category-filter" class="px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
          <option value="">All Categories</option>
          <option value="strength">Strength Training</option>
          <option value="cardio">Cardio</option>
          <option value="flexibility">Flexibility</option>
          <option value="hiit">HIIT</option>
          <option value="yoga">Yoga</option>
        </select>
      </div>
    </div>
    <div id="workouts-list" class="cards-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Workouts will be loaded here by JavaScript -->
    </div>
  </section>

  <!-- Edit Workout Modal -->
  <div id="edit-modal" class="modal fixed inset-0 bg-gray-600 bg-opacity-50 flex justify-center items-center z-50 hidden">
    <div class="modal-content bg-white p-6 rounded-lg w-full max-w-md">
      <span class="close absolute top-2 right-2 text-gray-600 cursor-pointer text-xl">&times;</span>
      <h2 class="text-2xl font-semibold mb-4">Edit Workout</h2>
      <form id="edit-form" class="space-y-4">
        <input type="hidden" id="edit-id">

        <div class="form-group">
          <label for="edit-name" class="block text-lg font-medium">Workout Name:</label>
          <input type="text" id="edit-name" name="name" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600" />
        </div>

        <div class="form-group">
          <label for="edit-description" class="block text-lg font-medium">Description:</label>
          <textarea id="edit-description" name="description" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600"></textarea>
        </div>

        <div class="form-group">
          <label for="edit-duration" class="block text-lg font-medium">Duration (minutes):</label>
          <input type="number" id="edit-duration" name="duration" required min="1" class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600" />
        </div>

        <div class="form-group">
          <label for="edit-difficulty" class="block text-lg font-medium">Difficulty Level:</label>
          <select id="edit-difficulty" name="difficulty" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
            <option value="beginner">Beginner</option>
            <option value="intermediate">Intermediate</option>
            <option value="advanced">Advanced</option>
          </select>
        </div>

        <div class="form-group">
          <label for="edit-category" class="block text-lg font-medium">Category:</label>
          <select id="edit-category" name="category" required class="w-full px-4 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
            <option value="strength">Strength Training</option>
            <option value="cardio">Cardio</option>
            <option value="flexibility">Flexibility</option>
            <option value="hiit">HIIT</option>
            <option value="yoga">Yoga</option>
          </select>
        </div>

        <button type="submit" class="w-full py-2 px-4 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 transition duration-200">Update Workout</button>
      </form>
    </div>
  </div>
</main>

