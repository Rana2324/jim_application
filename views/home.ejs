<%- include('partials/header') %>

<main class="home-page bg-gray-100">

  <!-- Hero Section -->
  <section class="hero bg-blue-600 text-white py-16">
    <div class="container mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold">Welcome to JIM</h1>
      <p class="mt-4 text-xl md:text-2xl">Your Ultimate Gym Management Solution</p>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features py-16">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-semibold text-gray-800 mb-8">Features</h2>
      <div class="feature-grid grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-12">
        <div class="feature-card bg-white p-8 rounded-lg shadow-lg hover:shadow-xl transition duration-300">
          <i class="fas fa-users text-4xl text-blue-600 mb-4"></i>
          <h3 class="text-2xl font-semibold text-gray-800 mb-4">Member Management</h3>
          <p class="text-gray-600 mb-4">Efficiently manage your gym members</p>
          <a href="/members" class="btn bg-blue-600 text-white py-3 px-6 rounded-lg hover:bg-blue-700 transition duration-300">Manage Members</a>
        </div>
        <div class="feature-card bg-white p-8 rounded-lg shadow-lg hover:shadow-xl transition duration-300">
          <i class="fas fa-dumbbell text-4xl text-blue-600 mb-4"></i>
          <h3 class="text-2xl font-semibold text-gray-800 mb-4">Workout Tracking</h3>
          <p class="text-gray-600 mb-4">Track workout programs and progress</p>
          <a href="/workouts" class="btn bg-blue-600 text-white py-3 px-6 rounded-lg hover:bg-blue-700 transition duration-300">View Workouts</a>
        </div>
        <div class="feature-card bg-white p-8 rounded-lg shadow-lg hover:shadow-xl transition duration-300">
          <i class="fas fa-chart-line text-4xl text-blue-600 mb-4"></i>
          <h3 class="text-2xl font-semibold text-gray-800 mb-4">Performance Records</h3>
          <p class="text-gray-600 mb-4">Monitor member performance</p>
          <a href="/records" class="btn bg-blue-600 text-white py-3 px-6 rounded-lg hover:bg-blue-700 transition duration-300">Check Records</a>
        </div>
      </div>
    </div>
  </section>

</main>

