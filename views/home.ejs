<%- include('partials/header') %>

<main class="home-page bg-gray-100">

  <!-- Hero Section -->
  <section class="hero bg-blue-600 text-white py-16">
    <div class="container mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold">Welcome to JIM</h1>
      <p class="mt-4 text-xl md:text-2xl">Your Ultimate Gym Management Solution</p>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features py-16 bg-gray-50">
    <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl sm:text-4xl font-semibold text-gray-800 mb-12">
            Features
        </h2>
        <div class="feature-grid grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
            <!-- Member Management -->
            <div class="feature-card bg-white p-6 sm:p-8 rounded-lg shadow-lg hover:shadow-xl transition duration-300 flex flex-col justify-between h-full">
                <div>
                    <i class="fas fa-users text-5xl text-blue-600 mb-4"></i>
                    <h3 class="text-2xl font-semibold text-gray-800 mb-4">Member Management</h3>
                    <p class="text-gray-600 mb-6">Efficiently manage your gym members and their subscriptions.</p>
                </div>
                <a href="/members" 
                   class="btn bg-blue-600 text-white py-3 px-6 w-full md:w-auto block md:inline-block rounded-lg hover:bg-blue-700 transition duration-300">
                    Manage Members
                </a>
            </div>

            <!-- Workout Tracking -->
            <div class="feature-card bg-white p-6 sm:p-8 rounded-lg shadow-lg hover:shadow-xl transition duration-300 flex flex-col justify-between h-full">
                <div>
                    <i class="fas fa-dumbbell text-5xl text-green-600 mb-4"></i>
                    <h3 class="text-2xl font-semibold text-gray-800 mb-4">Workout Tracking</h3>
                    <p class="text-gray-600 mb-6">Track workout programs, progress, and set fitness goals.</p>
                </div>
                <a href="/workouts" 
                   class="btn bg-green-600 text-white py-3 px-6 w-full md:w-auto block md:inline-block rounded-lg hover:bg-green-700 transition duration-300">
                    View Workouts
                </a>
            </div>

            <!-- Performance Records -->
            <div class="feature-card bg-white p-6 sm:p-8 rounded-lg shadow-lg hover:shadow-xl transition duration-300 flex flex-col justify-between h-full">
                <div>
                    <i class="fas fa-chart-line text-5xl text-purple-600 mb-4"></i>
                    <h3 class="text-2xl font-semibold text-gray-800 mb-4">Performance Records</h3>
                    <p class="text-gray-600 mb-6">Monitor and analyze member performance and milestones.</p>
                </div>
                <a href="/records" 
                   class="btn bg-purple-600 text-white py-3 px-6 w-full md:w-auto block md:inline-block rounded-lg hover:bg-purple-700 transition duration-300">
                    Check Records
                </a>
            </div>
        </div>
    </div>
</section>


</main>

