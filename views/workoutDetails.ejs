<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Gym Management</title>
    <link rel="stylesheet" href="/css/styles.css">
    <!-- Include Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
    <!-- Header -->
    <%- include('./partials/header') %>

    <main class="container mx-auto px-4 py-8">
        <div class="bg-white rounded-lg shadow-md p-6 max-w-3xl mx-auto">
            <h1 class="text-2xl font-bold text-gray-800 mb-6">Workout Details</h1>
            
            <% if (workout) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-4">
                        <div>
                            <h2 class="text-lg font-semibold text-gray-700">Workout Information</h2>
                            <div class="mt-2 border-t pt-2">
                                <p class="text-gray-600"><span class="font-medium">Name:</span> <%= workout.name %></p>
                                <p class="text-gray-600"><span class="font-medium">Type:</span> <%= workout.type %></p>
                                <p class="text-gray-600"><span class="font-medium">Difficulty:</span> <%= workout.difficulty %></p>
                                <p class="text-gray-600"><span class="font-medium">Equipment:</span> <%= workout.equipment %></p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="space-y-4">
                        <div>
                            <h2 class="text-lg font-semibold text-gray-700">Additional Details</h2>
                            <div class="mt-2 border-t pt-2">
                                <p class="text-gray-600"><span class="font-medium">Muscle Group:</span> <%= workout.muscleGroup %></p>
                                <p class="text-gray-600"><span class="font-medium">Added On:</span> <%= new Date(workout.createdAt).toLocaleDateString() %></p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="mt-6">
                    <h3 class="text-lg font-semibold text-gray-700">Instructions</h3>
                    <div class="mt-2 border-t pt-2">
                        <p class="text-gray-600"><%= workout.instructions %></p>
                    </div>
                </div>
                
                <div class="mt-8 flex space-x-4">
                    <a href="/workouts" class="px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700 transition">Back to Workouts</a>
                    <a href="/workouts/edit/<%= workout._id %>" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition">Edit Workout</a>
                </div>
            <% } else { %>
                <div class="text-center py-8">
                    <p class="text-gray-600">Workout not found.</p>
                    <a href="/workouts" class="mt-4 inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition">Back to Workouts</a>
                </div>
            <% } %>
        </div>
    </main>

    <!-- Footer -->
    <%- include('./partials/footer') %>

    <script src="/js/main.js"></script>
</body>
</html>
